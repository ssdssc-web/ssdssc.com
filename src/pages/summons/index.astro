---
export const prerender = true;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Summons — SSDSSC · Online Rounds Coming August 28</title>
    <meta
      name="description"
      content="Summons by SSDSSC — Online rounds launching August 28, 2026. The Science Society of D.S. Senanayake College presents its next major competition event."
    />
    <link rel="canonical" href="https://summons.ssdssc.com/" />
    <meta property="og:title" content="Summons — SSDSSC" />
    <meta property="og:description" content="Online rounds launching August 28. Stay tuned." />
    <meta property="og:url" content="https://summons.ssdssc.com/" />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://ssdssc.com/esper/images/vkkj1t1sjcafcrep0jyx09zbh8.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Summons — SSDSSC" />
    <meta name="twitter:description" content="Online rounds launching August 28." />

    <!-- Favicons -->
    <link rel="icon" href="/evo/images/HV81PvMuzPmNxmMjCAYb0u8UbY.png" />
    <link rel="apple-touch-icon" href="/evo/images/HV81PvMuzPmNxmMjCAYb0u8UbY.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700;900&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --blue: #006eaa;
        --blue-light: #0088cc;
        --blue-bright: #00a3f5;
        --cream: #f0f6ff;
        --cream-dim: rgba(220, 236, 255, 0.5);
        --bg: #000000;
      }

      html, body { height: 100%; }

      body {
        font-family: "Inter", sans-serif;
        background: var(--bg);
        color: var(--cream);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        position: relative;
      }

      /* Ambient glow */
      body::before {
        content: '';
        position: fixed;
        top: -20%;
        left: 50%;
        transform: translateX(-50%);
        width: 700px;
        height: 700px;
        background: radial-gradient(ellipse, rgba(0,110,170,0.12) 0%, transparent 70%);
        pointer-events: none;
        z-index: 0;
      }

      #particles {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
      }

      .page {
        position: relative;
        z-index: 1;
        text-align: center;
        padding: 2rem 1.5rem;
        max-width: 640px;
        width: 100%;
        animation: fadeUp 0.9s ease both;
      }

      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(20px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      /* Ornament */
      .ornament {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        margin-bottom: 2.5rem;
      }
      .ornament-line {
        width: 52px; height: 1px;
        background: linear-gradient(90deg, transparent, var(--blue));
      }
      .ornament-line:last-child {
        background: linear-gradient(90deg, var(--blue), transparent);
      }
      .ornament-dot {
        width: 5px; height: 5px;
        border-radius: 50%;
        background: var(--blue-bright);
        box-shadow: 0 0 12px var(--blue-light);
      }

      /* Label */
      .label {
        font-size: 0.65rem;
        font-weight: 500;
        letter-spacing: 0.25em;
        text-transform: uppercase;
        color: var(--blue-bright);
        margin-bottom: 3rem;
        opacity: 0;
        animation: fadeUp 0.8s ease 0.15s both;
      }

      /* Logo */
      .logo {
        width: 160px; height: 160px;
        object-fit: contain;
        margin: 0 auto 1.5rem;
        display: block;
        opacity: 0;
        animation: fadeUp 0.8s ease 0.25s both;
      }

      /* Title */
      h1 {
        font-family: 'DM Sans', sans-serif;
        font-size: clamp(3.5rem, 10vw, 6rem);
        font-weight: 400;
        line-height: 1;
        color: var(--cream);
        letter-spacing: -0.02em;
        margin-bottom: 0.2rem;
        opacity: 0;
        animation: fadeUp 0.8s ease 0.35s both;
      }
      h1 .italic-gold {
        color: var(--cream);
      }

      .by-line {
        font-size: 0.68rem;
        font-weight: 400;
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: var(--cream-dim);
        margin-bottom: 2rem;
        opacity: 0;
        animation: fadeUp 0.8s ease 0.42s both;
      }



      /* Divider */
      .v-divider {
        width: 1px; height: 36px;
        background: linear-gradient(to bottom, transparent, var(--blue-light), transparent);
        margin: 0 auto 2.5rem;
        opacity: 0;
        animation: fadeUp 0.8s ease 0.55s both;
      }

      /* Countdown */
      .countdown {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        gap: 0;
        margin-bottom: 2.5rem;
        opacity: 0;
        animation: fadeUp 0.8s ease 0.6s both;
      }
      .cd-unit {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.55rem;
      }
      .cd-box {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 90px;
        height: 90px;
        background: rgba(255,255,255,0.02);
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 10px;
        position: relative;
        flex-shrink: 0;
      }

      .cd-num {
        font-family: 'DM Sans', sans-serif;
        font-size: clamp(2.4rem, 6vw, 3.4rem);
        font-weight: 700;
        color: #ffffff;
        line-height: 1;
        letter-spacing: -0.02em;
        transition: color 0.3s ease;
      }
      .cd-num.flash { color: var(--blue-bright); transition: color 0s; }
      .cd-lbl {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.6rem;
        font-weight: 500;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: rgba(255,255,255,0.35);
      }
      .cd-sep {
        font-family: 'DM Sans', sans-serif;
        font-size: 1.8rem;
        font-weight: 300;
        color: rgba(255,255,255,0.15);
        line-height: 1;
        padding: 1.2rem 0.5rem 0;
        align-self: flex-start;
      }

      /* Date callout */
      .date-box {
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        background: transparent;
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 100px;
        padding: 0.55rem 1.5rem;
        margin-bottom: 2.2rem;
        opacity: 0;
        animation: fadeUp 0.8s ease 0.65s both;
      }
      .date-box .evt-lbl {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.62rem;
        font-weight: 500;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--blue-bright);
      }
      .date-box .divot {
        width: 3px;
        height: 3px;
        border-radius: 50%;
        background: rgba(255,255,255,0.2);
        flex-shrink: 0;
      }
      .date-box .evt-date {
        font-family: 'DM Sans', sans-serif;
        font-size: 0.75rem;
        font-weight: 500;
        color: rgba(255,255,255,0.7);
        letter-spacing: 0.04em;
      }

      /* Description */
      .desc {
        font-size: 0.82rem;
        color: var(--cream-dim);
        line-height: 1.9;
        max-width: 420px;
        margin: 0 auto 2.6rem;
        opacity: 0;
        animation: fadeUp 0.8s ease 0.72s both;
      }
      .desc strong { color: var(--cream); font-weight: 500; }

      /* Back button */
      .btn-back {
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        color: var(--cream-dim);
        text-decoration: none;
        padding: 9px 22px;
        font-size: 0.67rem;
        font-weight: 500;
        letter-spacing: 0.15em;
        text-transform: uppercase;
        border: 1px solid rgba(0,163,245,0.15);
        border-radius: 3px;
        transition: all 0.25s ease;
        opacity: 0;
        animation: fadeUp 0.8s ease 0.8s both;
      }
      .btn-back:hover {
        color: var(--cream);
        border-color: rgba(0,163,245,0.45);
        background: rgba(0,110,170,0.1);
        transform: translateY(-2px);
      }
      .btn-back svg { transition: transform 0.25s ease; }
      .btn-back:hover svg { transform: translateX(3px); }

      /* Footer */
      footer {
        position: fixed;
        bottom: 1.75rem;
        width: 100%;
        text-align: center;
        font-size: 0.63rem;
        letter-spacing: 0.12em;
        color: rgba(245,240,232,0.14);
        text-transform: uppercase;
        z-index: 1;
      }

      @media (max-width: 480px) {
        .cd-unit { min-width: 60px; }
        .cd-sep { font-size: 1.8rem; }
        .date-box { padding: 0.8rem 1.4rem; }
      }
    </style>
  </head>

  <body>
    <canvas id="particles"></canvas>

    <div class="page">
      <div class="ornament">
        <div class="ornament-line"></div>
        <div class="ornament-dot"></div>
        <div class="ornament-line"></div>
      </div>

      <p class="label">Science Society of D.S. Senanayake College</p>

      <img src="/evo/images/D2Dx5MiGs4RJlRrYE8cPIlUer1g.png" alt="Summons Logo" class="logo" />

      <h1><span class="italic-gold">Summons</span></h1>
      <p class="by-line">by SSDSSC</p>



      <div class="v-divider"></div>

      <div class="countdown" id="countdown" aria-label="Countdown to August 28 online rounds">
        <div class="cd-unit">
          <div class="cd-box"><div class="cd-num" id="cd-days">--</div></div>
          <div class="cd-lbl">Days</div>
        </div>
        <div class="cd-sep">:</div>
        <div class="cd-unit">
          <div class="cd-box"><div class="cd-num" id="cd-hours">--</div></div>
          <div class="cd-lbl">Hours</div>
        </div>
        <div class="cd-sep">:</div>
        <div class="cd-unit">
          <div class="cd-box"><div class="cd-num" id="cd-mins">--</div></div>
          <div class="cd-lbl">Mins</div>
        </div>
        <div class="cd-sep">:</div>
        <div class="cd-unit">
          <div class="cd-box"><div class="cd-num" id="cd-secs">--</div></div>
          <div class="cd-lbl">Secs</div>
        </div>
      </div>

      <div class="date-box">
        <p class="evt-lbl">Online Rounds Begin</p>
        <div class="divot"></div>
        <p class="evt-date">August 28, 2026</p>
      </div>

      <p class="desc">
        Summons is currently being prepared.<br />
        Online rounds open on <strong>August 28, 2026</strong>.<br />
        Check back then to register and compete.
      </p>

      <a href="/evo/register" class="btn-back" id="back-to-home">
        Go to Registration
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
          <path d="M5.5 2.5L10 7L5.5 11.5" stroke="currentColor" stroke-width="1.5"
                stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <footer>© 2026 SSDSSC · All Rights Reserved</footer>

    <script>
      // ── Countdown ─────────────────────────────────────────────────
      const TARGET = new Date('2026-08-28T00:00:00+05:30');
      const cdDays  = document.getElementById('cd-days');
      const cdHours = document.getElementById('cd-hours');
      const cdMins  = document.getElementById('cd-mins');
      const cdSecs  = document.getElementById('cd-secs');


      function pad(n) { return String(n).padStart(2, '0'); }

      function flashTick(el, val) {
        const str = pad(val);
        if (el.textContent !== str) {
          el.classList.add('flash');
          el.textContent = str;
          requestAnimationFrame(() => {
            el.classList.remove('flash');
          });
        }
      }

      function updateCountdown() {
        const diff = TARGET - Date.now();
        if (diff <= 0) {
          [cdDays, cdHours, cdMins, cdSecs].forEach(el => el.textContent = '00');
          return;
        }
        flashTick(cdDays,  Math.floor(diff / 86400000));
        flashTick(cdHours, Math.floor((diff % 86400000) / 3600000));
        flashTick(cdMins,  Math.floor((diff % 3600000) / 60000));
        flashTick(cdSecs,  Math.floor((diff % 60000) / 1000));
      }

      updateCountdown();
      setInterval(updateCountdown, 1000);

      // ── Floating gold particles ────────────────────────────────────
      const canvas = document.getElementById('particles');
      const ctx    = canvas.getContext('2d');
      let W, H, pts = [];

      function resize() {
        W = canvas.width  = window.innerWidth;
        H = canvas.height = window.innerHeight;
      }
      resize();
      window.addEventListener('resize', resize);

      function mkPt() {
        return {
          x: Math.random() * W,
          y: H + Math.random() * 20,
          r: Math.random() * 1.4 + 0.3,
          alpha: Math.random() * 0.35 + 0.05,
          vy: Math.random() * 0.3 + 0.08,
          vx: (Math.random() - 0.5) * 0.18,
        };
      }

      for (let i = 0; i < 55; i++) {
        const p = mkPt();
        p.y = Math.random() * H; // scatter on load
        pts.push(p);
      }

      function draw() {
        ctx.clearRect(0, 0, W, H);
        pts.forEach(p => {
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
          ctx.fillStyle = `rgba(0,163,245,${p.alpha})`;
          ctx.fill();
          p.y -= p.vy;
          p.x += p.vx;
          p.alpha -= 0.00025;
          if (p.y < -5 || p.alpha <= 0) Object.assign(p, mkPt());
        });
        requestAnimationFrame(draw);
      }
      draw();
    </script>
  </body>
</html>
